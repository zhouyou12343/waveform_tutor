# Optional advanced configuration template. The application does NOT load .env.
# Normal users can save URL/key/model/protocol in the webpage instead.
# Page settings persist in Git-ignored .waveform-tutor/ai-config.json and take
# precedence over this environment configuration. Never commit that local file.
# Clearing page settings disables AI, rather than falling back to the environment.
# Configure the backend process environment using your own secure environment
# or secret manager, then restart the backend. Core features work without AI.
# Do not put API keys in chat, frontend/VITE_* variables, source, screenshots,
# or commands that store plaintext secrets in shell history.
# Replace these placeholders; do not use them as working provider settings.
# The adapter appends /chat/completions or /responses according to AI_API_FORMAT.
AI_BASE_URL='<provider base URL ending /v1>'
AI_MODEL='<provider model identifier>'
# Supported values: chat_completions (default) or responses; never auto-falls back.
AI_API_FORMAT=chat_completions
# Deliberately empty. Supply the real key securely in the backend environment.
AI_API_KEY=
AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=2048
# 1 disables automatic retries; 2 preserves the default of at most one retry.
AI_MAX_ATTEMPTS=2
# Optional positive integer cap on HTTP attempts in this backend process.
# Retries, timeouts and cancellations consume it; restarting resets it.
# For an explicitly authorized first two-call session, use MAX_ATTEMPTS=1
# and REQUEST_BUDGET=2. Configuration is not authorization to make calls.
AI_REQUEST_BUDGET=
