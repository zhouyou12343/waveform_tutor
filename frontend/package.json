{
  "name": "waveform-tutor-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/utils.test.ts",
    "test:e2e": "playwright test",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,css}' 'tests/*.ts' '*.{json,ts,html}'"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.3.0",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "8.3.8"
  }
}
